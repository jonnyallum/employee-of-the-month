{
  "name": "employee-of-the-month",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "tsx --test src/domain/recognition/engine.test.ts src/lib/env.test.ts",
    "test:watch": "tsx --test --watch src/domain/recognition/engine.test.ts src/lib/env.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "doctor": "expo-doctor",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.110.8",
    "expo": "57.0.8",
    "expo-constants": "57.0.7",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.8",
    "expo-splash-screen": "57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.4",
    "expo-doctor": "1.17.11",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
